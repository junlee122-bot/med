# ============================================================================
# HelixForge AI — backend environment (copy to helixforge/.env or backend/.env)
# ============================================================================
# All values are OPTIONAL. With none set, the app still runs: real public APIs
# (PubMed, ClinicalTrials.gov, ChEMBL) and RDKit/TDC work out of the box; tools
# that need extra setup (Vina, REINVENT4) report CONFIGURED_BUT_NOT_RUN instead
# of faking results.

# --- Service ---
ENVIRONMENT=development
# Comma-separated CORS origins allowed to call the API.
CORS_ORIGINS=http://localhost:5174,http://localhost:5173,http://127.0.0.1:5174
# Sent as the User-Agent to external APIs (NCBI asks that you identify yourself).
HTTP_USER_AGENT=HelixForgeAI/1.0 (research decision support)

# --- NCBI / PubMed (E-utilities) ---
# Optional API key raises the rate limit from 3 to 10 req/s. Email is requested
# by NCBI usage policy. Both are recommended for heavy use, not required.
NCBI_API_KEY=
NCBI_EMAIL=

# --- AutoDock Vina ---
# Path or name of the vina executable. If not installed, docking reports
# CONFIGURED_BUT_NOT_RUN and the app keeps working.
VINA_BIN=vina

# --- REINVENT4 ---
# Point these at a separate REINVENT4 installation to enable real runs.
# See docs/TOOL_INTEGRATION.md. If unset, config generation still works but a
# run reports CONFIGURED_BUT_NOT_RUN.
REINVENT4_PYTHON=
REINVENT4_BIN=

# --- Operational ---
CHUNK_SIZE=50
TIMEOUT_SECONDS=30
# SQLite path (Postgres-ready abstraction; swap DB_PATH for a DSN in future).
# DB_PATH=./data/helixforge.db

# ============================================================================
# Phase 7 — optional Fable 5 / LLM hybrid reasoning layer
# ============================================================================
# The app runs fully WITHOUT any of these. With no key / USE_LLM=false, every
# reasoning step (planner, hypotheses, critic) uses a deterministic fallback and
# says so. Never commit a real key.
ANTHROPIC_API_KEY=
HELIXFORGE_USE_LLM=false
# deterministic | HYBRID_LLM_DEV | HYBRID_FABLE_FINAL | RECORDED_HYBRID_REPLAY
HELIXFORGE_LLM_MODE=deterministic
HELIXFORGE_LLM_DEV_MODEL=claude-sonnet-5
HELIXFORGE_LLM_CHEAP_MODEL=claude-haiku-4-5
HELIXFORGE_LLM_FINAL_MODEL=claude-fable-5
HELIXFORGE_LLM_PLANNER_MODEL=claude-sonnet-5
HELIXFORGE_LLM_HYPOTHESIS_MODEL=claude-fable-5
HELIXFORGE_LLM_CRITIC_MODEL=claude-fable-5
HELIXFORGE_LLM_MAX_COST_PER_RUN_USD=2.00
HELIXFORGE_LLM_MAX_COST_PER_DAY_USD=20.00
HELIXFORGE_LLM_MAX_OUTPUT_TOKENS_PLANNER=2500
HELIXFORGE_LLM_MAX_OUTPUT_TOKENS_HYPOTHESIS=3500
HELIXFORGE_LLM_MAX_OUTPUT_TOKENS_CRITIC=2500
HELIXFORGE_LLM_STORE_FULL_PROMPTS=false
HELIXFORGE_LLM_ENABLE_PROMPT_CACHE=true
HELIXFORGE_LLM_TIMEOUT_SECONDS=90
HELIXFORGE_LLM_MAX_RETRIES=1
HELIXFORGE_LLM_EFFORT=medium
# Optional promotional Sonnet 5 pricing override (USD per MTok).
# HELIXFORGE_SONNET5_INPUT_USD_PER_MTOK=2.00
# HELIXFORGE_SONNET5_OUTPUT_USD_PER_MTOK=10.00
# Gate the tiny live smoke test (needs a real key). Off by default.
HELIXFORGE_ENABLE_LIVE_LLM_SMOKE=false
